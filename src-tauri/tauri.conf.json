{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "多多解密",
  "version": "0.1.0",
  "identifier": "com.jdd.crypto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "badge",
        "title": "多多解密",
        "url": "index.html",
        "width": 96,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "main",
        "title": "多多解密",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["plugins/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
